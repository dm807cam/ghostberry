{{!< default}}

<div class="feed">
    {{#foreach posts}}
        {{#if @first}}
            {{#is "home"}}
                {{> "post-feature"}}
                {{#unless @last}}<h2 class="label feed-label">{{t "Earlier"}}</h2>{{/unless}}
            {{else}}
                {{> "post-row"}}
            {{/is}}
        {{else}}
            {{> "post-row"}}
        {{/if}}
    {{/foreach}}
</div>

{{pagination}}

{{!-- On a phone the rail's form is folded into the menu, so offer it here too. --}}
<div class="subscribe-phone">
    {{> "subscribe"}}
</div>

{{#is "home"}}
    {{#if @site.recommendations_enabled}}
        <section class="recs">
            <h2 class="label">{{t "Recommended"}}</h2>
            {{recommendations}}
        </section>
    {{/if}}
{{/is}}
