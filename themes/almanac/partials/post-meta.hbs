<p class="meta">
    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="ll"}}</time>
    {{#primary_tag}}
        <span class="meta-dot" aria-hidden="true"></span>
        <a class="meta-tag" href="{{url}}">{{name}}</a>
    {{/primary_tag}}
    {{#if show_reading_time}}
        <span class="meta-dot" aria-hidden="true"></span>
        <span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
    {{/if}}
    {{#if featured}}
        <span class="meta-dot" aria-hidden="true"></span>
        <span>{{t "Featured"}}</span>
    {{/if}}
    {{#match visibility "!=" "public"}}
        <span class="meta-dot" aria-hidden="true"></span>
        <span class="meta-access">
            <svg aria-hidden="true" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5.5" width="8" height="5.5" rx="1"/><path d="M4 5.5V4a2 2 0 0 1 4 0v1.5"/></svg>
            {{#match visibility "members"}}{{t "Members only"}}{{else}}{{t "Paid"}}{{/match}}
        </span>
    {{/match}}
</p>
