<aside class="rail" data-rail>
    <div class="rail-head">
        <a class="wordmark" href="{{@site.url}}">
            {{#if @site.logo}}
                <img src="{{@site.logo}}" alt="{{@site.title}}">
            {{else}}
                {{@site.title}}
            {{/if}}
        </a>
        <button class="menu-toggle" type="button" aria-label="{{t "Menu"}}" aria-expanded="false" aria-controls="rail-body" data-menu-toggle>
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 8h16"/><path d="M3 14h16"/></svg>
        </button>
    </div>

    {{#is "post"}}
        <a class="rail-back" href="{{@site.url}}">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 9H3"/><path d="M7.5 4.5 3 9l4.5 4.5"/></svg>
            {{t "All writing"}}
        </a>
    {{else}}
        {{#if @site.description}}
            <p class="rail-desc">{{@site.description}}</p>
        {{/if}}
    {{/is}}

    <div class="rail-body" id="rail-body">
        <nav class="rail-nav" aria-label="{{t "Main"}}">
            {{navigation}}
            <button class="rail-search" type="button" data-ghost-search>
                {{t "Search"}}
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3 3"/></svg>
            </button>
        </nav>

        {{#if @site.members_enabled}}
            {{#unless @member}}
                {{#unless @site.members_invite_only}}
                    <form class="rail-subscribe" data-members-form="subscribe">
                        <label for="rail-email">{{t "New posts by email."}}</label>
                        <div class="field">
                            <input id="rail-email" type="email" name="email" placeholder="{{t "Email address"}}" autocomplete="email" required data-members-email>
                            <button type="submit" aria-label="{{t "Subscribe"}}">
                                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h12"/><path d="M10.5 4.5 15 9l-4.5 4.5"/></svg>
                            </button>
                        </div>
                        <p class="form-note form-success" role="status">{{t "Check your inbox to confirm."}}</p>
                        <p class="form-note form-error" role="alert" data-members-error></p>
                    </form>
                {{/unless}}
            {{/unless}}
        {{/if}}
    </div>

    {{#is "post"}}
        {{#if @custom.show_table_of_contents}}
            <nav class="toc" aria-labelledby="toc-title" data-toc hidden>
                <h2 class="label" id="toc-title">{{t "In this post"}}</h2>
                <ol class="toc-list" data-toc-list></ol>
            </nav>
        {{/if}}
    {{/is}}
</aside>
