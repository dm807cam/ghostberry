<article class="feature {{post_class}}">
    {{#if feature_image}}
        <a class="feature-image" href="{{url}}" tabindex="-1" aria-hidden="true">
            <img
                srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1280w"
                sizes="(min-width: 1024px) 640px, calc(100vw - 40px)"
                src="{{img_url feature_image size="m"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                fetchpriority="high">
        </a>
    {{/if}}
    {{> "post-meta" show_reading_time=true}}
    <h2 class="feature-title"><a href="{{url}}">{{title}}</a></h2>
    <p class="feature-excerpt{{#unless custom_excerpt}} is-clamped{{/unless}}">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="70"}}{{/if}}</p>
</article>
