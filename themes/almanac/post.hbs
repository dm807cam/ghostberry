{{!< default}}

{{#post}}
<article class="post {{post_class}}">

    <header class="post-head">
        {{> "post-meta" show_reading_time=true}}
        <h1 class="post-title">{{title}}</h1>
        {{#if custom_excerpt}}
            <p class="post-deck">{{custom_excerpt}}</p>
        {{/if}}
    </header>

    {{#if feature_image}}
        <figure class="post-figure">
            <img
                srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1280w, {{img_url feature_image size="xl"}} 2000w"
                sizes="(min-width: 1024px) 640px, calc(100vw - 40px)"
                src="{{img_url feature_image size="l"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                fetchpriority="high">
            {{#if feature_image_caption}}
                <figcaption>{{{feature_image_caption}}}</figcaption>
            {{/if}}
        </figure>
    {{/if}}

    {{#if @custom.show_table_of_contents}}
        <details class="toc-inline" data-toc hidden>
            <summary>In this post</summary>
            <ol class="toc-list" data-toc-list></ol>
        </details>
    {{/if}}

    <div class="content gh-content" data-content>
        {{content}}
    </div>

    {{#if tags}}
        <p class="filed">Filed under {{tags separator=", "}}</p>
    {{/if}}

</article>

{{> "subscribe"}}

<nav class="adjacent" aria-label="More posts">
    {{#prev_post}}
        <a class="adjacent-link" href="{{url}}">
            <span class="label">Previous</span>
            <span class="adjacent-title">{{title}}</span>
        </a>
    {{/prev_post}}
    {{#next_post}}
        <a class="adjacent-link adjacent-next" href="{{url}}">
            <span class="label">Next</span>
            <span class="adjacent-title">{{title}}</span>
        </a>
    {{/next_post}}
</nav>

{{#if comments}}
    <section class="comments">
        {{comments}}
    </section>
{{/if}}
{{/post}}
