<!DOCTYPE html>
<html lang="{{@site.locale}}"{{#match @custom.color_scheme "Dark"}} class="theme-dark"{{/match}}{{#match @custom.color_scheme "Light"}} class="theme-light"{{/match}}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/source-serif-4-latin-opsz-normal.woff2"}}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/fraunces-latin-opsz-normal.woff2"}}" crossorigin>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">

    {{ghost_head}}
</head>
<body class="{{body_class}}">
<a class="skip-link" href="#main">{{t "Skip to content"}}</a>

<div class="shell">
    {{> "rail"}}

    <main id="main" class="main">
        {{{body}}}
    </main>

    <footer class="foot">
        <span class="foot-credit">
            <span>&copy; {{date format="YYYY"}} {{@site.title}}</span>
            {{#if @custom.hosted_with_ghostberry}}
                <a href="https://dm807cam.github.io/ghostberry/">{{t "Hosted with Ghostberry"}}</a>
            {{/if}}
        </span>
        <span class="foot-links">
            {{#if @site.secondary_navigation}}
                {{#foreach @site.secondary_navigation}}<a href="{{url absolute="true"}}">{{label}}</a>{{/foreach}}
            {{/if}}
            {{#if @site.facebook}}<a href="{{social_url type="facebook"}}" rel="me noopener">Facebook</a>{{/if}}
            {{#if @site.twitter}}<a href="{{social_url type="twitter"}}" rel="me noopener">X</a>{{/if}}
            <a href="{{@site.url}}/rss/">RSS</a>
            {{#if @site.members_enabled}}
                {{#if @member}}
                    <a href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                {{else}}
                    <a href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                {{/if}}
            {{/if}}
        </span>
    </footer>
</div>

<script src="{{asset "js/main.js"}}" defer></script>
{{ghost_foot}}
</body>
</html>
