{{!< default}}

{{#tag}}
<header class="archive-head">
    <p class="label">Filed under</p>
    <h1 class="archive-title">{{name}}</h1>
    {{#if description}}
        <p class="archive-desc">{{description}}</p>
    {{/if}}
</header>
{{/tag}}

<div class="feed">
    {{#foreach posts}}
        {{> "post-row"}}
    {{/foreach}}
</div>

{{pagination}}
