{{!< default}}

{{#author}}
<header class="archive-head">
    <p class="label">Written by</p>
    <h1 class="archive-title">{{name}}</h1>
    {{#if bio}}
        <p class="archive-desc">{{bio}}</p>
    {{/if}}
</header>
{{/author}}

<div class="feed">
    {{#foreach posts}}
        {{> "post-row"}}
    {{/foreach}}
</div>

{{pagination}}
