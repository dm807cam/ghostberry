# Ghostberry environment configuration
# Copy to .env and fill in. NEVER commit .env.
# `setup.sh` (or the one-shot installer) will write this for you.

# ---------------- Ghost ----------------
# Public URL of your Ghost blog (must include https://)
GHOST_URL=https://blog.example.com

# ---------------- Database -------------
# Generated by setup.sh; only set manually if you know what you're doing.
GHOST_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---------------- Cloudflare Tunnel ----
# Cloudflare dashboard → Networking → Tunnels → Create a tunnel (Docker).
# Add a route: Published application → service URL http://ghost:2368
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------- Mail -----------------
# Ghost needs email for staff invites, password resets and member sign-in
# links (newsletters are separate: Ghost only sends those through Mailgun).
# Pick a mode, then re-run ./setup.sh — it fills in the rest.
#   builtin  run the bundled send-only mail server (maddy, ~10 MB RAM).
#            Needs outbound port 25, OR a relay (MAIL_RELAY_*) below.
#   smtp     Ghost talks directly to an external SMTP provider (MAIL_HOST…).
#   none     no email.
MAIL_MODE=builtin
# Enables the mail container. setup.sh keeps this in sync with MAIL_MODE.
COMPOSE_PROFILES=mail

# What Ghost connects to. builtin → MAIL_HOST=mail, MAIL_PORT=2525.
# ${MAIL_HOST:+SMTP} in docker-compose.yml turns SMTP on when this is set.
MAIL_HOST=mail
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@blog.example.com
# true only for implicit TLS (port 465)
MAIL_SECURE=false

# builtin only. The domain mail is sent and DKIM-signed as. Ghost sends
# member emails from noreply@<your site's domain>, so keep these equal.
MAIL_DOMAIN=blog.example.com
# HELO name; defaults to MAIL_DOMAIN.
MAIL_HOSTNAME=
MAIL_DKIM_SELECTOR=ghost
# Optional smarthost for the built-in server (STARTTLS, usually port 587).
# Use it when port 25 is blocked or for better deliverability; mail is
# still DKIM-signed with your own key. No whitespace in user/password.
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=

# ---------------- Backups --------------
# AES-256 passphrase for encrypted backups. Auto-generated by setup.sh.
# Without this, backups are stored unencrypted (still chmod 600).
BACKUP_ENCRYPTION_KEY=
# Number of backup archives to keep.
BACKUP_KEEP=7

# ---------------- Off-site backups -----
# r2 = copy every backup to Cloudflare R2 (free up to 10 GB/month).
# Set up in guides/BACKUP.md; check with ./scripts/offsite.sh test.
OFFSITE=none
# R2 overview page → Account ID (32 hex characters)
R2_ACCOUNT_ID=
R2_BUCKET=ghostberry-backups
# default | eu | fedramp — must match where the bucket was created
R2_JURISDICTION=default
# Folder inside the bucket
R2_PREFIX=ghostberry
# R2 API token with "Object Read & Write" on this bucket only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Number of backups to keep in R2
OFFSITE_KEEP=7

# ---------------- Image pins -----------
# Override to pin specific versions. Defaults track the maintained tags.
# MySQL 8.4 LTS also works for NEW installs (MYSQL_IMAGE=mysql:8.4).
GHOST_IMAGE=ghost:6-alpine
MYSQL_IMAGE=mysql:8.0
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
MAIL_IMAGE=ghcr.io/foxcpp/maddy:0.9.7
RCLONE_IMAGE=rclone/rclone:1.76.0

# ---------------- Resource caps --------
# Tune for your Pi. Defaults target a 2 GB Pi 4.
GHOST_MEM_LIMIT=768m
DB_MEM_LIMIT=512m
CLOUDFLARED_MEM_LIMIT=128m
MAIL_MEM_LIMIT=64m
MYSQL_BUFFER_POOL=128M
